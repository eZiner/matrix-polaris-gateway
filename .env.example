# ==============================================================================
# POLARIS GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Kopiere diese Datei als '.env' in deinen Konfigurations-Ordner (z.B. production/.env)
# und passe die Werte an deine lokale Infrastruktur an.
# ==============================================================================

# 1. POSTGIS DATENBANK-VERBINDUNG
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://polaris_user:dein_sicheres_passwort@localhost:5432/polaris_db

# 2. AMT LICHE BKG-GEODATEN (VG25)
# Absoluter Pfad zur heruntergeladenen 'DE_VG25.gpkg' Datei im UTM32N-Format.
# Windows-Beispiel: G:/projects/polaris/database/vg25_utm32/DE_VG25.gpkg
# Linux-Beispiel:   /var/polaris/database/DE_VG25.gpkg
BKG_GPKG_PATH=path/to/your/vg25_utm32/DE_VG25.gpkg
