# ==============================================================================
# POLARIS GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Kopiere diese Datei als '.env' in deinen Konfigurations-Ordner (z.B. production/.env)
# und passe die Werte an deine lokale Infrastruktur an.
# ==============================================================================


# ==============================================================================
# 🛠️ GENERAL GATEWAY CONFIGURATION (RUST)
# ==============================================================================

# Schaltet zwischen Trockenübung (Simulation) und Live-Matrix-Betrieb um.
# true  = Simuliert m.location Events und Matrix-API-Aufrufe lokal im Terminal.
# false = Verbindet sich live mit dem Synapse-Server und lauscht auf echte Events.
POLARIS_TEST_MODE=true

# ==============================================================================
# 🐘 POSTGRESQL / POSTGIS CONFIGURATION (RUST & DOCKER COMPOSE)
# ==============================================================================

# Einzelne Fragmente, die von der docker-compose.yml eingelesen werden:
DB_USER=polaris
DB_PASSWORD=DEIN_SICHERES_PASSWORT
DB_NAME=polaris_geo

# Die zusammengesetzte Verbindungs-URL für das Rust-Backend (SQLx / geofence.rs):
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@127.0.0.1:5432/${DB_NAME}

# ==============================================================================
# 📡 MATRIX SYNAPSE CONFIGURATION (RUST & DOCKER COMPOSE)
# ==============================================================================

# Der Domainname deines autarken Matrix-Homeservers (Inselmodus):
MATRIX_SERVER_NAME=goslar.de

# Die lokale HTTP-Schnittstelle von Synapse, die der Rust-Bot anfunkt:
MATRIX_HOMESERVER=http://127.0.0.1:8008

# Die Zugangsdaten des Bot-Accounts auf dem Synapse-Server:
MATRIX_USER=@polaris_bot:YOUR-MATRIX-SERVER.de
MATRIX_PASSWORD=EIN_SEPARATES_SICHERES_BOT_PASSWORT

# ==============================================================================
# 🗺️ GEODATA IMPORT CONFIGURATION (PYTHON / GIS)
# ==============================================================================

# Absoluter Pfad zur GeoPackage-Datei des Bundesamtes für Kartographie (BKG):
BKG_GPKG_PATH=path/to/your/vg25_utm32/DE_VG25.gpkg
